# Скопируется в .env автоматически при ./install.sh
# Пароль change_me будет заменён на случайный при первой установке.

# --- Версии образов (зафиксируй и обновляй осознанно) ---
SYSLOGNG_VERSION=4.8.1
ALLOY_VERSION=v1.10.0
LOKI_VERSION=3.5.0
GRAFANA_VERSION=12.0.0

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change_me

# --- Хранение ---
# Каталог файлового архива syslog-ng (лучше отдельный диск/раздел)
ARCHIVE_DIR=/srv/syslog/archive
# Сколько хранить логи в Loki (поиск в Grafana)
LOKI_RETENTION=744h
# Файлы архива старше N дней сжимаются gzip
ARCHIVE_COMPRESS_AFTER_DAYS=2
# Сжатые файлы архива старше N дней удаляются
ARCHIVE_RETENTION_DAYS=180

# --- Лимиты памяти контейнеров ---
LOKI_MEM_LIMIT=2g
GRAFANA_MEM_LIMIT=512m
